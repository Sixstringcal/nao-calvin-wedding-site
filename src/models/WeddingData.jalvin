import @jalvin/runtime.listOf
import src.constants.strings.Res

const val COUPLE_NAMES: String = "Nao Hayashi and Calvin Nielson"
const val WEDDING_DATE: String = "April 25, 2027"
const val VENUE_NAME: String = "Hollins House"
const val VENUE_ADDRESS: String = "20 Clubhouse Rd, Santa Cruz, CA 95060"

data class RsvpPayload(
    val fullName: String,
    val email: String,
    val guestCount: Int,
    val additionalGuestNames: List<String>,
    val attending: Boolean,
    val dietaryNotes: String,
    val message: String,
    val submittedAt: String
)

data class AdditionalGuestInput(
    val id: String,
    val name: String
)

data class ScheduleItem(
    val time: String,
    val title: String,
    val description: String = ""
)

data class RegistryItem(
    val label: String,
    val description: String = "",
    val url: String = "",
    val category: String = "Registry"
)

data class GalleryPhoto(
    val src: String,
    val alt: String
)

fun scheduleItems(): List<ScheduleItem> {
    return listOf(
        ScheduleItem(time = "3:30 PM", title = Res.SCHEDULE_GUEST_ARRIVAL, description = "Welcome refreshments & terrace gathering"),
        ScheduleItem(time = "4:30 PM", title = Res.SCHEDULE_CEREMONY, description = "Vows exchange overlooking the Monterey Bay"),
        ScheduleItem(time = "5:15 PM", title = Res.SCHEDULE_COCKTAILS, description = "Signature drinks, passed hors d'oeuvres & golden hour photos"),
        ScheduleItem(time = "6:30 PM", title = Res.SCHEDULE_DINNER, description = "Seated dinner, heartfelt toasts, cake & dancing beneath the trees")
    )
}

fun registryItems(): List<RegistryItem> {
    return listOf(
        RegistryItem(
            label = "Honeymoon & Travel Fund",
            description = "Help us craft lifelong memories on our honeymoon adventure across Japan and beyond.",
            url = "https://www.zola.com/registry/nao-and-calvin",
            category = "Experiences & Travel"
        ),
        RegistryItem(
            label = "Crate & Barrel",
            description = "Timeless entertaining pieces, everyday ceramics, glassware, and cozy home accents.",
            url = "https://www.crateandbarrel.com",
            category = "Home & Dining"
        ),
        RegistryItem(
            label = "Williams Sonoma",
            description = "Heirloom cookware, kitchen essentials, and specialty tools for shared dinner parties.",
            url = "https://www.williams-sonoma.com",
            category = "Kitchen & Entertaining"
        )
    )
}

fun galleryPhotos(): List<GalleryPhoto> {
    return listOf(
        GalleryPhoto(
            src = "photos/engagement-01.jpg",
            alt = "Engagement photo one"
        ),
        GalleryPhoto(
            src = "photos/engagement-02.jpg",
            alt = "Engagement photo two"
        ),
        GalleryPhoto(
            src = "photos/engagement-03.jpg",
            alt = "Engagement photo three"
        )
    )
}
