import @jalvin/ui.Box
import @jalvin/ui.Column
import @jalvin/ui.Row
import @jalvin/ui.Text
import @jalvin/ui.Modifier
import @jalvin/ui.TextStyle
import @jalvin/ui.useMutableInteractionSource
import @jalvin/ui.useIsHovered
import src.models.WeddingData.COUPLE_NAMES
import src.models.WeddingData.WEDDING_DATE
import src.constants.strings.Res

import @jalvin/ui.Card

component fun NavChip(label: String, pageKey: String, selectedPage: String, onSelect: (String) -> Unit) {
    val interactionSource = useMutableInteractionSource()
    val isHovered = useIsHovered(interactionSource)
    val isSelected = selectedPage == pageKey

    return Card(
        modifier = Modifier
            .padding("4px 14px")
            .background("transparent")
            .border("none")
            .borderRadius(0)
            .boxShadow("none")
            .cursor("pointer")
            .hoverable(interactionSource),
        elevation = 0,
        outlined = false,
        onClick = { onSelect(pageKey) }
    ) {
        Column(
            modifier = Modifier.Default,
            spacing = 6,
            horizontalAlignment = "center"
        ) {
            Text(
                text = label,
                style = TextStyle.labelLarge,
                modifier = Modifier.Default
                    .fontFamily("'Montserrat', -apple-system, sans-serif")
                    .letterSpacing("0.16em")
                    .fontSize(12)
                    .fontWeight(if (isSelected) 600 else 400),
                color = if (isSelected) "#34261e" else if (isHovered) "#5c4333" else "#857365",
            )
            Box(
                modifier = Modifier
                    .width(if (isSelected) 28 else if (isHovered) 16 else 0)
                    .height("1.5px")
                    .background(if (isSelected) "#b28a64" else if (isHovered) "#d8c3b0" else "transparent")
                    .transition("all 0.25s ease")
            ) {}
        }
    }
}

component fun NavBar(selectedPage: String, onSelect: (String) -> Unit) {
    return Row(
        modifier = Modifier.fillMaxWidth().marginTop(12),
        spacing = 4,
        wrap = true,
        horizontalArrangement = "center",
    ) {
        NavChip(label = Res.WELCOME_LABEL, pageKey = "welcome", selectedPage = selectedPage, onSelect = onSelect)
        NavChip(label = Res.DETAILS_LABEL, pageKey = "details", selectedPage = selectedPage, onSelect = onSelect)
        NavChip(label = Res.REGISTRY_LABEL, pageKey = "registry", selectedPage = selectedPage, onSelect = onSelect)
        NavChip(label = Res.RSVP_LABEL, pageKey = "rsvp", selectedPage = selectedPage, onSelect = onSelect)
    }
}

component fun WeddingHeader(selectedPage: String, onSelect: (String) -> Unit) {
    return Box(
        modifier = Modifier
            .fillMaxWidth()
            .background("#faf6f0")
            .border("none")
            .boxShadow("0 1px 0 rgba(216, 199, 181, 0.45)")
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .maxWidth(960)
                .margin("0 auto")
                .padding("36px 24px 20px 24px"),
            spacing = 10,
            horizontalAlignment = "center",
        ) {
            Text(
                text = "N  ✦  C",
                style = TextStyle.titleSmall,
                modifier = Modifier.Default
                    .fontFamily("'Cormorant Garamond', Georgia, serif")
                    .letterSpacing("0.35em")
                    .textAlign("center"),
                color = "#a68260",
            )

            Text(
                text = COUPLE_NAMES,
                style = TextStyle.displayMedium,
                modifier = Modifier.Default
                    .fontFamily("'Cormorant Garamond', Georgia, serif")
                    .letterSpacing("0.04em")
                    .textAlign("center"),
                color = "#2e231c",
            )

            Row(
                verticalAlignment = "center",
                spacing = 10
            ) {
                Box(modifier = Modifier.width(32).height("1px").background("#dfcebe")) {}
                Text(
                    text = "${WEDDING_DATE.toUpperCase()}  •  ${Res.HEADER_LOCATION.toUpperCase()}",
                    style = TextStyle.titleSmall,
                    modifier = Modifier.Default
                        .fontFamily("'Montserrat', -apple-system, sans-serif")
                        .letterSpacing("0.2em")
                        .fontSize(11)
                        .textAlign("center"),
                    color = "#7d6b5e",
                )
                Box(modifier = Modifier.width(32).height("1px").background("#dfcebe")) {}
            }

            NavBar(selectedPage = selectedPage, onSelect = onSelect)
        }
    }
}
