import @jalvin/runtime.*
import @jalvin/ui.Box
import @jalvin/ui.Card
import @jalvin/ui.Column
import @jalvin/ui.Row
import @jalvin/ui.Text
import @jalvin/ui.Input
import @jalvin/ui.TextArea
import @jalvin/ui.Button
import @jalvin/ui.Modifier
import @jalvin/ui.TextStyle
import @jalvin/ui.Color
import @jalvin/ui.useMutableInteractionSource
import @jalvin/ui.useIsHovered
import src.models.WeddingData.AdditionalGuestInput
import src.constants.strings.Res


component fun RemoveGuestButton(onClick: () -> Unit) {
    val interactionSource = useMutableInteractionSource()
    val isHovered = useIsHovered(interactionSource)

    return Card(
        onClick = onClick,
        modifier = Modifier
            .background(if (isHovered) "#fae8e8" else "transparent")
            .border(if (isHovered) "1px solid #e0b0b0" else "1px solid #ecd8d8")
            .borderRadius(20)
            .padding("4px 10px")
            .hoverable(interactionSource)
            .cursor("pointer"),
        elevation = 0,
        outlined = false
    ) {
        Text(
            text = "Remove",
            color = if (isHovered) "#9e2c2c" else "#b86363",
            style = TextStyle.labelSmall,
            modifier = Modifier.Default
                .fontFamily("'Montserrat', -apple-system, sans-serif")
                .fontSize(11)
                .letterSpacing("0.05em")
        )
    }
}

component fun AddGuestButton(onClick: () -> Unit) {
    val interactionSource = useMutableInteractionSource()
    val isHovered = useIsHovered(interactionSource)

    return Button(
        onClick = onClick,
        variant = "text",
        modifier = Modifier
            .width("fit-content")
            .border(if (isHovered) "1px solid #8e6844" else "1px solid #c9b49e")
            .background(if (isHovered) "#f4ede4" else "#faf5ed")
            .borderRadius(24)
            .padding("8px 22px")
            .marginTop(6)
            .hoverable(interactionSource)
            .cursor("pointer")
    ) {
        Text(
            text = Res.RSVP_ADD_GUEST_BUTTON,
            style = TextStyle.labelLarge,
            modifier = Modifier.Default
                .fontFamily("'Montserrat', -apple-system, sans-serif")
                .letterSpacing("0.1em")
                .fontSize(11),
            color = if (isHovered) "#322319" else "#5a4537"
        )
    }
}

component fun SubmitRsvpButton(onClick: () -> Unit, isSubmitting: Boolean) {
    val interactionSource = useMutableInteractionSource()
    val isHovered = useIsHovered(interactionSource)

    return Button(
        onClick = onClick,
        variant = "text",
        enabled = !isSubmitting,
        modifier = Modifier
            .fillMaxWidth()
            .height(52)
            .border(if (isHovered && !isSubmitting) "1.5px solid #8e6844" else "1px solid #bba38a")
            .background(if (isHovered && !isSubmitting) "#423227" else "#33261d")
            .borderRadius(28)
            .boxShadow(if (isHovered && !isSubmitting) "0 6px 18px rgba(51, 38, 29, 0.25)" else "0 2px 8px rgba(51, 38, 29, 0.12)")
            .hoverable(interactionSource)
            .cursor(if (isSubmitting) "default" else "pointer")
    ) {
        Text(
            text = if (isSubmitting) Res.RSVP_SENDING else Res.RSVP_SUBMIT_BUTTON,
            style = TextStyle.bodyLarge,
            modifier = Modifier.Default
                .fontFamily("'Montserrat', -apple-system, sans-serif")
                .letterSpacing("0.18em")
                .fontSize(12)
                .fontWeight(500),
            color = "#faf6f0"
        )
    }
}

component fun RsvpSection(
    fullName: String,
    email: String,
    additionalGuestNames: List<AdditionalGuestInput> = listOf(),
    dietaryNotes: String,
    note: String,
    isSubmitting: Boolean,
    statusText: String,
    statusColor: Color,
    onFullNameChange: (String) -> Unit,
    onEmailChange: (String) -> Unit,
    onAddAdditionalGuestName: () -> Unit,
    onAdditionalGuestNameChange: (String, String) -> Unit,
    onRemoveAdditionalGuestName: (String) -> Unit,
    onDietaryNotesChange: (String) -> Unit,
    onNoteChange: (String) -> Unit,
    onSubmit: () -> Unit,
) {
    return Box(
        modifier = Modifier
            .fillMaxWidth()
            .padding("8px 0 36px 0")
            .background("transparent")
    ) {
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .maxWidth(720)
                .margin("0 auto")
                .padding("44px 36px")
                .background("#ffffff")
                .border("1px solid #ebd9c8")
                .borderRadius(20)
                .boxShadow("0 16px 40px -15px rgba(60, 45, 35, 0.08)")
        ) {
            Column(modifier = Modifier.fillMaxWidth(), spacing = 22) {
                // Header of the RSVP Invitation Card
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    spacing = 8,
                    horizontalAlignment = "center"
                ) {
                    Text(
                        text = "R.S.V.P.",
                        style = TextStyle.displaySmall,
                        modifier = Modifier.Default
                            .fontFamily("'Cormorant Garamond', Georgia, serif")
                            .letterSpacing("0.18em")
                            .textAlign("center"),
                        color = "#2e2118"
                    )

                    Row(verticalAlignment = "center", spacing = 12, modifier = Modifier.margin("4px 0")) {
                        Box(modifier = Modifier.width(36).height("1px").background("#dccbb9")) {}
                        Text(text = "✦", style = TextStyle.bodySmall, color = "#b28a64", modifier = Modifier.Default.fontSize(10))
                        Box(modifier = Modifier.width(36).height("1px").background("#dccbb9")) {}
                    }

                    Text(
                        text = Res.RSVP_RESPOND_BY,
                        style = TextStyle.bodyMedium,
                        modifier = Modifier.Default
                            .fontFamily("'Cormorant Garamond', Georgia, serif")
                            .fontSize(18)
                            .lineHeight("1.5")
                            .textAlign("center"),
                        color = "#6f5d50"
                    )
                }

                // Guest Details Inputs
                Column(modifier = Modifier.fillMaxWidth(), spacing = 16) {
                    Input(
                        value = fullName,
                        onValueChange = { v -> onFullNameChange(v) },
                        label = Res.RSVP_FULL_NAME_LABEL,
                        placeholder = Res.RSVP_FULL_NAME_PLACEHOLDER,
                        modifier = Modifier.fillMaxWidth()
                    )

                    Input(
                        value = email,
                        onValueChange = { v -> onEmailChange(v) },
                        label = Res.RSVP_EMAIL_LABEL,
                        placeholder = Res.RSVP_EMAIL_PLACEHOLDER,
                        type = "email",
                        modifier = Modifier.fillMaxWidth()
                    )
                }

                // Additional Guests Section
                Column(modifier = Modifier.fillMaxWidth(), spacing = 12) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = "spaceBetween",
                        verticalAlignment = "center"
                    ) {
                        Text(
                            text = Res.RSVP_ADDITIONAL_GUESTS_TITLE.toUpperCase(),
                            style = TextStyle.labelSmall,
                            modifier = Modifier.Default
                                .fontFamily("'Montserrat', -apple-system, sans-serif")
                                .letterSpacing("0.18em")
                                .fontSize(11),
                            color = "#8b725d"
                        )
                    }

                    for (guest in additionalGuestNames) {
                        Row(modifier = Modifier.fillMaxWidth(), spacing = 12, verticalAlignment = "center") {
                            Input(
                                value = guest.name,
                                onValueChange = { v -> onAdditionalGuestNameChange(guest.id, v) },
                                placeholder = Res.RSVP_GUEST_NAME_PLACEHOLDER,
                                modifier = Modifier.fillMaxWidth()
                            )
                            RemoveGuestButton(onClick = { onRemoveAdditionalGuestName(guest.id) })
                        }
                    }

                    AddGuestButton(onClick = onAddAdditionalGuestName)
                }

                // Dietary Notes
                TextArea(
                    value = dietaryNotes,
                    onValueChange = { v -> onDietaryNotesChange(v) },
                    label = Res.RSVP_DIETARY_LABEL,
                    placeholder = Res.RSVP_DIETARY_PLACEHOLDER,
                    rows = 3,
                    modifier = Modifier.fillMaxWidth()
                )

                // Message for the Couple
                TextArea(
                    value = note,
                    onValueChange = { v -> onNoteChange(v) },
                    label = Res.RSVP_MESSAGE_LABEL,
                    placeholder = Res.RSVP_MESSAGE_PLACEHOLDER,
                    rows = 4,
                    modifier = Modifier.fillMaxWidth()
                )

                SubmitRsvpButton(onClick = onSubmit, isSubmitting = isSubmitting)

                if (statusText.length > 0) {
                    Text(
                        text = statusText,
                        style = TextStyle.bodyMedium,
                        color = if (statusColor == Color.OnSurfaceVariant) "#7a6759" else statusColor,
                        modifier = Modifier.Default
                            .fontFamily("'Montserrat', -apple-system, sans-serif")
                            .fontSize(13)
                            .textAlign("center")
                            .fillMaxWidth()
                    )
                }
            }
        }
    }
}
